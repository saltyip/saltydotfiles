{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces", "clock"],
    "modules-center": [],
    "modules-right": ["memory", "battery", "backlight", "pulseaudio", "tray", "network"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate"
    },

    "clock": {
        "format": "{:%H:%M  %a %d %b}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "memory": {
        "format": "󰍛 {percentage}%",
        "tooltip-format": "{used:0.1f}GB / {total:0.1f}GB"
    },

    "battery": {
    "format": "{icon} {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "format-charging": "󰂄 {capacity}%",
    "states": {
        "warning": 20,
        "critical": 10
    },
    "on-click": "gnome-power-statistics"
    },

    "backlight": {
        "format": "󰃞 {percent}%"
    },
    
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
        "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pamixer -t",
    "on-click-right": "ghostty -e wiremix"
},

    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-disconnected": "󰤭",
        "format-ethernet": "󰈀 connected",
        "tooltip-format": "{ifname}: {ipaddr}",
        "on-click": "ghostty -e nmtui"
    },


    "tray": {
    "spacing": 8
    }
}
